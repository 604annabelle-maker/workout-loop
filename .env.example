# Every one of these is optional in development. Missing credentials degrade to
# printing rather than sending, and to a canned workout rather than a generated
# one, so the whole loop runs on a laptop with none of this filled in.

# --- database ---
DATABASE_URL=postgres://localhost:5432/workout_loop

# --- generation ---
# Without this, the generator returns a canned plan.
ANTHROPIC_API_KEY=

# --- who this is for ---
# Workouts are sent here, and this is the only address whose replies are
# processed. Everything else is ignored.
OWNER_EMAIL=

# --- the booking webhook, called by the Ellé Fitness app ---
# Shared secret for the HMAC signature over the request body.
BOOKING_WEBHOOK_SECRET=

# --- the cron endpoint, called by GitHub Actions ---
CRON_SECRET=

# --- the preferences page ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- the mailbox ---
# One account does both directions. Workouts are sent from it, and replies come
# back to it, which is what lets a reply find the workout it answers.
#
# Until MAILBOX_ADDRESS is set, mail is printed to the console instead of sent
# and the reply poller does nothing, so the whole loop still runs locally.
#
# For Gmail the password is an App Password, which requires 2FA on the account.
MAILBOX_ADDRESS=
MAILBOX_PASSWORD=

# Only needed for a provider other than Gmail. These default to Gmail's.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
